---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { href, asset, t, langPaths, type Lang } from '../../i18n';
import { TELEGRAM_BOT_URL } from '../../config';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const d = t(lang);
const h = d.home;

// Технологии в бегущей ленте
const tech = [
  'Rust', 'Python', 'React', 'Tauri', 'Electron', 'Node.js', 'JavaScript', 'Linux', 'Git',
  'GitHub', 'C++', 'C#', 'Docker', 'AI/LLM', 'TypeScript', 'WinUI3', 'PowerShell',
];
const rowA = tech;
const rowB = [...tech.slice(8), ...tech.slice(0, 8)];
---

<BaseLayout lang={lang}>
  <!-- Первый экран -->
  <section class="hero" data-spotlight>
    <div class="top-glow"></div>
    <div class="hero-spot" aria-hidden="true"></div>
    <div class="container hero-inner">
      <h1>
        <span class="hero-title enter"><span class="outline-title" data-text="United Software Engineers">United Software Engineers</span></span>
        <span class="hero-tagline enter" style="--d:150ms">{h.tagline}</span>
      </h1>
      <p class="hero-lead enter" style="--d:300ms">{h.lead}</p>
      <div class="hero-actions enter" style="--d:450ms">
        <a class="btn" href={href(lang, 'projects')}>{h.btnProjects}</a>
        <a class="btn btn--primary" href={TELEGRAM_BOT_URL} target="_blank" rel="noopener">{h.btnJoin}</a>
      </div>
    </div>

    <div class="marquee enter" style="--d:650ms" aria-hidden="true">
      {[rowA, rowB].map((row, i) => (
        <div class:list={['marquee-row', { reverse: i === 1 }]}>
          <div class="marquee-track">
            {[...row, ...row].map((name) => <span class="tag">{name}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Где родился клуб -->
  <section class="section born">
    <div class="duo">
      <div class="orb" data-reveal="left">
        <img class="float" src={asset('images/use-logo.svg')} alt="USE" width="100" height="83" />
      </div>
      <div class="orb orb--muted" data-reveal="right" style="--d:120ms">
        <img class="float" style="animation-delay:-3s" src={asset('images/university-logo.svg')} alt="Auezov University" width="72" height="72" />
      </div>
    </div>
    <div class="container born-text">
      <h2 class="section-title" data-reveal>{h.born.title}</h2>
      <p class="section-lead" data-reveal style="--d:120ms">{h.born.text}</p>
    </div>
  </section>

  <!-- Чем занимаемся -->
  <section class="section what">
    <div class="container">
      <h2 class="section-title" data-reveal>{h.what.title}</h2>
      <div class="grid-3 what-grid">
        {h.what.items.map((item, i) => (
          <article class="card" data-reveal style={`--d:${i * 120}ms`}>
            <span class="num">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Университет + два пути -->
  <section class="arc-wrap">
    <div class="arc" data-reveal="scale" aria-hidden="true"></div>
    <div class="container uni">
      <img class="uni-logo" data-reveal src={asset('images/university-logo.svg')} alt="" width="96" height="96" />
      <h2 data-reveal style="--d:100ms">{h.uni.title}</h2>
      <p class="uni-sub" data-reveal style="--d:180ms">{h.uni.subtitle}</p>
      <p class="uni-text" data-reveal style="--d:260ms">{h.uni.text}</p>
    </div>

    <div class="container ways">
      <h2 class="ways-title" data-reveal>{h.ways.title}</h2>
      <div class="ways-grid">
        <article class="card way" data-reveal style="--d:80ms">
          <h3>{h.ways.first.title}</h3>
          <p>{h.ways.first.text}</p>
          <a class="btn btn--primary btn--sm btn--block" href={TELEGRAM_BOT_URL} target="_blank" rel="noopener">
            {h.ways.first.btn}
          </a>
        </article>
        <article class="card way" data-reveal style="--d:200ms">
          <h3>{h.ways.second.title}</h3>
          <p>{h.ways.second.text}</p>
          <a class="btn btn--sm btn--block" href={href(lang, 'collaboration')}>
            {h.ways.second.btn}<Icon name="arrow" />
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Первый экран ---------- */
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(72px, 12vw, 120px));
    padding-bottom: clamp(40px, 8vw, 80px);
    overflow: hidden;
    text-align: center;
  }

  .hero-spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(500px circle at var(--x, 50%) var(--y, -20%), rgb(var(--glow) / 0.22), transparent 60%);
    pointer-events: none;
    transition: opacity 0.5s;
  }

  .hero-inner {
    position: relative;
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 2vw, 18px);
  }

  .hero-title {
    font-size: clamp(38px, 8.2vw, 92px);
  }

  .hero-tagline {
    font-size: clamp(28px, 4.4vw, 44px);
    color: var(--text);
  }

  .hero-lead {
    max-width: 560px;
    margin: 22px auto 0;
    color: var(--text-2);
    font-size: clamp(14px, 1.6vw, 16px);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* ---------- Бегущая лента технологий ---------- */
  .marquee {
    position: relative;
    margin-top: clamp(80px, 14vw, 130px);
    display: grid;
    gap: 10px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee-row {
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    gap: 10px;
    width: max-content;
    animation: marquee 50s linear infinite;
  }

  .marquee-row.reverse .marquee-track {
    animation-direction: reverse;
    animation-duration: 58s;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee .tag {
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }

  .marquee .tag:hover {
    color: var(--text);
    border-color: var(--blue);
    background: rgb(30 102 255 / 0.14);
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 5px));
    }
  }

  /* ---------- Два круга ---------- */
  .duo {
    display: flex;
    justify-content: center;
    padding-inline: 16px;
  }

  .orb {
    position: relative;
    width: min(300px, 46vw);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    background: radial-gradient(circle, rgb(var(--glow) / 0.6) 0%, rgb(var(--glow) / 0.18) 38%, transparent 68%);
  }

  .orb + .orb {
    margin-left: min(-36px, -6vw);
  }

  /* комета, бегущая по окружности */
  .orb::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0 78%, rgb(143 176 255 / 0.9) 96%, transparent 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
    animation: spin 9s linear infinite;
  }

  .orb--muted::before {
    animation-duration: 12s;
    animation-direction: reverse;
  }

  .orb img {
    width: 34%;
    height: auto;
    filter: drop-shadow(0 10px 30px rgb(0 0 0 / 0.6));
  }

  .orb--muted img {
    width: 26%;
    opacity: 0.72;
  }

  .float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  .born {
    padding-top: clamp(40px, 6vw, 80px);
  }

  .born-text {
    position: relative;
    margin-top: clamp(-48px, -4vw, -20px);
  }

  .born .section-title {
    font-size: clamp(32px, 5vw, 48px);
  }

  /* ---------- Чем занимаемся ---------- */
  .what {
    padding-top: 0;
  }

  .what-grid {
    margin-top: 40px;
  }

  /* ---------- Дуга, университет, два пути ---------- */
  .arc-wrap {
    position: relative;
    padding-top: clamp(90px, 12vw, 130px);
    padding-bottom: clamp(80px, 10vw, 120px);
    overflow: hidden;
  }

  .arc {
    position: absolute;
    top: 0;
    left: 50%;
    --arc: clamp(760px, 104vw, 1500px);
    width: var(--arc);
    aspect-ratio: 1;
    margin-left: calc(var(--arc) / -2);
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: radial-gradient(circle at 50% 0%, rgb(var(--glow) / 0.22), transparent 32%);
    box-shadow: inset 0 1px 30px -10px rgb(143 176 255 / 0.35);
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 30%, transparent 52%);
    mask-image: linear-gradient(to bottom, #000 0, #000 30%, transparent 52%);
    pointer-events: none;
  }

  :global(html.js) .arc[data-reveal='scale'] {
    transform: scale(0.96);
    transition-duration: 1.6s;
  }

  :global(html.js) .arc[data-reveal].is-visible {
    transform: none;
  }

  .uni {
    position: relative;
    text-align: center;
  }

  .uni-logo {
    width: clamp(72px, 9vw, 96px);
    height: auto;
    margin: 0 auto 28px;
  }

  .uni h2 {
    font-size: clamp(28px, 4.4vw, 42px);
  }

  .uni-sub {
    margin-top: 10px;
    color: #8b92a0;
    font-size: clamp(16px, 2vw, 21px);
  }

  .uni-text {
    max-width: 620px;
    margin: 14px auto 0;
    color: var(--text-3);
    font-size: 14px;
  }

  .ways {
    position: relative;
    margin-top: clamp(80px, 12vw, 120px);
  }

  .ways-title {
    text-align: center;
    font-size: clamp(36px, 6.4vw, 62px);
  }

  .ways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 12px;
    max-width: 840px;
    margin: clamp(36px, 5vw, 56px) auto 0;
  }

  .way {
    display: flex;
    flex-direction: column;
  }

  .way h3 {
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.2;
  }

  .way p {
    color: var(--text);
    margin-bottom: 20px;
  }

  .way .btn {
    margin-top: auto;
  }

  .way .btn :global(svg) {
    transition: transform 0.3s var(--ease);
  }

  .way .btn:hover :global(svg) {
    transform: translateX(3px);
  }
</style>
