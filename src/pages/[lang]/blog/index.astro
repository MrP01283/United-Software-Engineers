---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { href, t, langPaths, formatDate, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const d = t(lang);
const b = d.blog;

const posts = (await getCollection('blog', (e) => e.id.startsWith(`${lang}/`) && !e.data.draft)).sort(
  (a, z) => z.data.date.getTime() - a.data.date.getTime(),
);
const slugOf = (id: string) => id.split('/').slice(1).join('/');
---

<BaseLayout lang={lang} title={b.title} description={b.lead}>
  <section class="page-hero">
    <div class="top-glow"></div>
    <div class="container">
      <h1 class="enter">{b.title}</h1>
      <p class="enter" style="--d:120ms">{b.lead}</p>
    </div>
  </section>

  <section class="container posts">
    {posts.length === 0 && <p class="empty">{b.empty}</p>}
    {posts.map((post, i) => (
      <a class="card post" href={href(lang, `blog/${slugOf(post.id)}`)} data-reveal style={`--d:${i * 80}ms`}>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        <div class="body">
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="tags">{post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}</div>
          )}
        </div>
        <span class="more">{b.readMore}<Icon name="arrow" /></span>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .posts {
    display: grid;
    gap: 12px;
    max-width: 860px;
    padding-bottom: clamp(80px, 10vw, 120px);
  }

  .post {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 24px;
    align-items: start;
    padding: 26px;
  }

  time {
    color: var(--text-3);
    font-size: 13px;
    padding-top: 4px;
  }

  h2 {
    font-size: 22px;
    margin-bottom: 8px;
    transition: color 0.2s;
  }

  .post:hover h2 {
    color: var(--blue-soft);
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-size: 13px;
    padding-top: 4px;
    white-space: nowrap;
  }

  .more :global(svg) {
    width: 15px;
    height: 15px;
    transition: transform 0.3s var(--ease);
  }

  .post:hover .more :global(svg) {
    transform: translateX(4px);
  }

  .empty {
    text-align: center;
    color: var(--text-3);
  }

  @media (max-width: 680px) {
    .post {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 20px;
    }
  }
</style>
